{
  "name": "macro-grid-client",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/renderer",
    "packages/renderer/demo"
  ],
  "scripts": {
    "dev": "vite --port 5191",
    "build": "vite build",
    "typecheck": "tsc --noEmit && npm run typecheck -w @macro/renderer",
    "test": "vitest run && npm test -w @macro/renderer",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "@macro/renderer": "file:packages/renderer",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
